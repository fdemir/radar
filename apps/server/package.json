  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@radar/config": "workspace:*",
    "@radar/infra": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
