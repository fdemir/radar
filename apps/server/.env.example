# Local development generates and persists its own auth secret.
# Set a persistent secret of at least 32 characters before cloud deployment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5174
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
TINYFISH_API_KEY=
# Optional email delivery, verification, and password recovery.
RESEND_API_KEY=
EMAIL_FROM=

# Optional Discord User Install. Must match a redirect registered in Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:3000/api/discord/callback
